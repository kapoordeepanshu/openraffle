# ───────────────────────── Required ─────────────────────────
# SQLite file by default. For Postgres: postgresql://user:pass@host:5432/openraffle
DATABASE_URL="file:./dev.db"

# Public URL of the site (used in Stripe redirects, receipts and emails)
SITE_URL="http://localhost:3000"

# Admin login for /admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-something-long"

# 32+ random characters. Signs admin sessions and encrypts Stripe keys saved in the admin.
# Generate one with: npx tsx -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-64-hex-characters-from-the-command-above-0000000000"

# ───────────────────────── Branding ─────────────────────────
SITE_NAME="Apex Motor Draws"
SITE_TAGLINE="Win your dream car for the price of a coffee."
LEGAL_NAME="Apex Motor Draws Ltd"
SUPPORT_EMAIL="support@example.com"
CURRENCY="gbp"
LOCALE="en-GB"
MIN_AGE="18"

# ─────────────────── Free entry (UK prize competitions) ───────────────────
FREE_ENTRY_ENABLED="true"
FREE_ENTRY_ADDRESS="Apex Motor Draws, Free Entry, 1 Example Street, London, EC1A 1AA"

# ───────────────────────── Payments ─────────────────────────
# Optional: you can instead connect Stripe from Admin → Payments (keys are stored encrypted).
# Leave blank to run in demo mode (simulated payments).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
# Force a mode regardless of keys: "demo" | "stripe"
PAYMENTS_MODE=""
# Minutes a checkout holds tickets before releasing them
RESERVATION_MINUTES="30"
# Automatically refund a payment that lands after a raffle sold out
AUTO_REFUND_OVERSOLD="true"

# ───────────────────────── Email (optional) ─────────────────────────
# Sends the PDF receipt to entrants. Any SMTP provider works (Resend, Postmark, SES, Gmail…)
SMTP_URL=""
MAIL_FROM="Apex Motor Draws <tickets@example.com>"
